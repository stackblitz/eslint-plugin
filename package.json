{
  "name": "@blitz/eslint-plugin",
  "version": "0.1.5",
  "license": "MIT",
  "description": "An ESLint config to enforce a consistent code styles across StackBlitz projects",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "stackblitz"
  ],
  "author": "Dominic Elm",
  "main": "dist/index.js",
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "build": "rm -rf dist && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint '{src,test}/**/*'",
    "preversion": "pnpm test",
    "postversion": "git push && git push --tags",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "files": [
    "dist",
    "docs",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.9.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@typescript-eslint/utils": "^8.56.0",
    "common-tags": "^1.8.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsonc": "^3.0.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unicorn": "^65.0.0",
    "typescript-eslint": "^8.56.0"
  },
  "devDependencies": {
    "@blitz/eslint-plugin": "link:./",
    "@types/common-tags": "^1.8.4",
    "@types/node": "^20.14.8",
    "eslint": "^10.0.0",
    "eslint-vitest-rule-tester": "^3.1.0",
    "jsonc-eslint-parser": "^3.0.0",
    "prettier": "^3.3.2",
    "typescript": "~5.9.0",
    "vitest": "^1.6.0"
  }
}
